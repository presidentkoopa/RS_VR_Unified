# RS_HandHUD plate: a unit quad, -1..1 in X (width) and Y (height), z = 0,
# facing +Z. MODELDEF Scale sets the half-extents in model units.
#
# UVs: v = 1 at the TOP edge. If the readout renders upside down in the
# headset, swap the vt lines' second column (0 <-> 1) -- nothing else.
v -1.0 -1.0 0.0
v  1.0 -1.0 0.0
v  1.0  1.0 0.0
v -1.0  1.0 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 0.0 1.0
vn 0.0 0.0 -1.0
# front
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
# back, same UVs, so it is never invisible from the wrong side
f 1/1/2 3/3/2 2/2/2
f 1/1/2 4/4/2 3/3/2
